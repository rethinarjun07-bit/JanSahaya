# Canonical Database URL: Default is local zero-config SQLite; toggle to PostgreSQL 16 for production:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/jansahaya?schema=public"
DATABASE_URL="file:./dev.db"

# JWT Secret — generate a secure 64-char random string in production (openssl rand -hex 32)
JWT_SECRET="generate-a-secure-random-32-character-secret-in-production"

# Demo Mode — allows 1-click role switcher for CITIZEN/SOLVER/INDUSTRY in testing
DEMO_MODE="true"
NEXT_PUBLIC_DEMO_MODE="true"

# Google Gemini AI API Key (Optional) — get from https://aistudio.google.com/app/apikey
# If absent or offline, JanSahaya automatically falls back to local deterministic intelligence & rule engines
GEMINI_API_KEY=""

# Optional Python Backend URL (for auxiliary scikit-learn / whisper services)
# FASTAPI_BACKEND_URL="http://localhost:8000"
